<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Order Confirmed! 🎉</title>
  <link rel="stylesheet" href="/style.css?v=5">
</head>

<body style="background-color: var(--apple-bg); font-family: -apple-system, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; padding: 20px;">

    <div style="background: white; padding: 40px; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); text-align: center; max-width: 450px; width: 100%;">
        <span style="font-size: 50px;">🎉</span>
        <h1 style="font-size: 26px; margin: 15px 0;">Thank you, #(customerName)!</h1>
        <p style="font-size: 16px; color: #1d1d1f; line-height: 1.5; margin-bottom: 25px;">
            Your order for <b>"#(bookTitle)"</b> has been placed successfully.<br><br>
            We will contact you shortly at <b>#(customerPhone)</b> to arrange the delivery to:<br>
            <i style="color: #515154;">#(customerAddress)</i>.
        </p>
        <a href="/" class="buy-button" style="display: inline-block; width: auto; padding: 12px 30px; text-decoration: none; border-radius: 12px;">Back to Showcase</a>
    </div>
</body>
</html>
