<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>#(title) - Details</title>
  <link rel="stylesheet" href="/style.css?v=5">
</head>
<body style="background-color: var(--apple-bg); margin: 0; padding: 20px;">

  <div class="detail-container">
    <div>
        <a href="/" class="back-btn">← Back to all books</a>
        <br>
        <img src="#(image)" alt="Book Cover">
    </div>

    <div class="detail-content">
        <h1>#(title)</h1>
        <p style="font-size: 16px; color: #515154; margin: 5px 0;"><b>Author:</b> #(author)</p>
        <p style="font-size: 22px; font-weight: 700; color: #1d1d1f; margin: 15px 0;">#(price)</p>
        <p style="font-size: 15px; line-height: 1.6; color: #1d1d1f; margin-bottom: 20px;">#(description)</p>

        <div id="buyButtonContainer" style="margin-top: 30px;">
            <button class="buy-button" onclick="showOrderForm()" style="width: auto; padding: 12px 40px; border-radius: 12px; font-size: 16px;">Buy now</button>
        </div>

        <div id="orderFormContainer" style="display: none; width: 100%; max-width: 350px; margin-top: 30px; padding: 25px; background: #f5f5f7; border-radius: 18px; border: 1px solid #d2d2d7; box-sizing: border-box;">
            <h3 style="margin: 0 0 15px 0; font-size: 18px; color: #1d1d1f;">Quick Order 🚀</h3>

            <form action="/submit-order" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
                <input type="hidden" name="bookTitle" value="#(title)">

                <input type="text" name="customerName" placeholder="Full Name" required style="padding: 12px; border-radius: 10px; border: 1px solid #d2d2d7; font-size: 14px; background: white; width: 100%; box-sizing: border-box;">
                <input type="tel" name="customerPhone" placeholder="Phone Number" required style="padding: 12px; border-radius: 10px; border: 1px solid #d2d2d7; font-size: 14px; background: white; width: 100%; box-sizing: border-box;">
                <input type="text" name="customerAddress" placeholder="Delivery Address" required style="padding: 12px; border-radius: 10px; border: 1px solid #d2d2d7; font-size: 14px; background: white; width: 100%; box-sizing: border-box;">

                <button type="submit" class="buy-button" style="width: 100%; padding: 12px; border-radius: 12px; margin-top: 5px;">Confirm Order</button>
                <button type="button" onclick="hideOrderForm()" class="cancel-pink-btn">← Cancel</button>
            </form>
        </div>
    </div>
  </div>

  <script>
    function showOrderForm() {
        document.getElementById('buyButtonContainer').style.display = 'none';
        document.getElementById('orderFormContainer').style.display = 'block';
    }

    function hideOrderForm() {
        document.getElementById('orderFormContainer').style.display = 'none';
        document.getElementById('buyButtonContainer').style.display = 'block';
    }
  </script>

</body>
</html>
